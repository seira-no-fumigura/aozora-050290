     "a": "候",
     "r": "さふら"
    },
    {
     "a": "今更",
     "r": "いまさら"
    },
    {
     "a": "申上",
     "r": "まをしあぐ"
    },
    {
     "a": "紐育",
     "r": "ニユーヨーク"
    },
    {
     "a": "明",
     "r": "あかる"
    },
    {
     "a": "眩",
     "r": "まばゆ"
