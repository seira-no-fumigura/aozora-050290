   "author": "",
   "text": "余は都会の夜を愛し候。燦爛たる燈火の巷を愛し候。",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose",
   "ruby": [
    {
     "a": "夜",
     "r": "よる"
